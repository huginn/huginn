<% content_for :title, "Agents" -%>

<div class='container agents-index'>
  <div class='row'>
    <div class='col-md-12'>
      <div class="page-header">
        <h2><%= session[:original_admin_user_id].present? ? "#{current_user.username}’s Agents" : 'Your Agents' %></h2>
        <% if @service %>
          <p class="text-muted">
            Filtered by service:
            <%= agent_filter_service_label(@service) %>
          </p>
        <% end %>
        <% if @scenario %>
          <p class="text-muted">Filtered by scenario: <%= scenario_label(@scenario) %></p>
        <% elsif params[:without_scenario].present? || params[:scenario_id] == 'none' %>
          <p class="text-muted">
            Showing agents that are not assigned to a scenario.
          </p>
        <% end %>
      </div>

      <div class="agents-index-layout">
        <%= render 'agents/filters' %>
        <div class="agents-index-main">
          <%= render 'agents/table' %>

          <br/>

          <div class="btn-group">
            <%= link_to icon_tag('glyphicon-plus') + ' New Agent', new_agent_path, class: "btn btn-default" %>
            <%= link_to icon_tag('glyphicon-refresh') + ' Run event propagation', propagate_agents_path, method: 'post', class: "btn btn-default" %>
            <%= link_to icon_tag('glyphicon-random') + ' View diagram', diagram_path, class: "btn btn-default" %>
            <%= link_to icon_tag('glyphicon-adjust') + toggle_disabled_text, toggle_visibility_agents_path(agent_filter_params), method: :put, class: "btn btn-default visibility-enabler" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
