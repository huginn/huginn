<% content_for :head do -%>
<%= location_map_head_tags(@agent.options[:api_key]) %>
<% end -%>

<h3>Recent Event Map</h3>

<% events = @agent.events.with_location.order("id desc").limit(500) %>
<% if events.length > 0 %>
  <div id="map_canvas" style="width:800px; height:800px"></div>

  <script type="text/javascript">
    var locations = <%= Utils.jsonify(events.map(&:location)) %>;
    var map = LocationMap.create(document.getElementById("map_canvas"), locations[0], 15);
    map.fitTo(locations);
    var circles = [];
    var points = [];
    locations.forEach(function(loc) {
      if (loc.radius > 1) {
        circles.push(map.addLocation(loc));
      }
      delete loc.radius;
      points.push(map.addLocation(loc));
    });

    function toggleAccuracy(group, visible) {
      group.forEach(function(overlay) {
        if (visible) {
          overlay.show();
        } else {
          overlay.hide();
        }
      });
    }

    toggleAccuracy(circles, false);

    $(document).ready(function() {
      $("input#toggle").on("click", function() {
        var showCircles = $(this).is(":checked");
        toggleAccuracy(circles, showCircles);
        toggleAccuracy(points, !showCircles);
      });
      if(circles.length > 0){
        $(".toggle-accuracy").removeClass("hidden");
      }
    });

  </script>
<% else %>
  <p>
    No events found.
  </p>
<% end %>

<div class="hidden toggle-accuracy checkbox">
  <label>
    <input id="toggle" type="checkbox" value="">
    Show accuracy of locations
  </label>
</div>

<h3>POST URL</h3>

<p>
  Location data containing <code>latitude</code> and <code>longitude</code> can be posted to this URL:<br/>

  <ul>
    <li><code class="selectable-text"><%= web_requests_url(user_id: @agent.user_id, agent_id: @agent.id, secret: @agent.options['secret']) %></code></li>
  </ul>
</p>
<p>The data can also include <code>radius</code>, <code>speed</code>, and <code>course</code> values.</p>
